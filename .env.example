# Backend API origin.
#
# Development: leave empty — requests use relative paths (/api/*, /hubs/*) and
# are proxied to Railway by the Vite dev server (see vite.config.ts).
#
# Production (Vercel): set to the full backend origin so the browser calls it
# directly (the Vite dev proxy does not exist in production builds).
#   VITE_API_BASE_URL=https://housing-platform.onrender.com
#
# Note: Vite inlines VITE_* variables at build time, so changing this value
# requires a redeploy.
VITE_API_BASE_URL=
